{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "electron/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
