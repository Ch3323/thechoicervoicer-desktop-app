{
  "name": "collaborative-dubbing-studio",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "ffmpeg-static"
  ],
  "scripts": {
    "postinstall": "bun run --cwd apps/desktop install:electron",
    "dev": "bun run --cwd apps/desktop dev",
    "start": "bun run --cwd apps/desktop start",
    "typecheck": "bun run --cwd apps/desktop typecheck && bun run --cwd packages/shared typecheck",
    "lint": "bun run --cwd apps/desktop lint && bun run --cwd packages/shared lint",
    "test": "bun run --cwd apps/desktop test",
    "build": "bun run --cwd apps/desktop build",
    "dist:win": "bun run --cwd apps/desktop dist:win",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
